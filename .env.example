# Copy to .env and fill in every value:  cp .env.example .env
# docker compose reads .env automatically; it is gitignored and never baked into the image.

# --- Postgres -------------------------------------------------------------
# Used by the db container to initialise the database, and by the api to connect.
# Postgres only applies USER/PASSWORD/DB/TEST_DB when its data volume is first created.
# After changing them, recreate the volume: docker compose down -v && docker compose up --build
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Separate database for the test suite (created by docker/postgres/init on first start).
POSTGRES_TEST_DB=
# Where the api reaches Postgres: the compose service name and its container port.
POSTGRES_HOST=
POSTGRES_PORT=

# --- API ------------------------------------------------------------------
# Host port the API is published on (the container itself listens on 8000).
API_PORT=
